# TactiVision AI — Environment Variables
# Copy this file to backend/.env for local development
# For Railway/Render: set these as environment variables in the dashboard

# Database — Railway will use sqlite:////data/tactivision.db (persistent disk)
# For PostgreSQL: postgresql://user:password@host:5432/tactivision
DATABASE_URL=sqlite:////data/tactivision.db

# LLM API Keys (optional — only needed for AI Coach Assistant feature)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Frontend — set this on Vercel as an environment variable
# Replace with your actual Railway backend URL after deploying
NEXT_PUBLIC_API_URL=https://your-backend.railway.app
